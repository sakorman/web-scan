+    fn ssim_batched(&self, img1: Tensor<B, 3>, img2: Tensor<B, 3>) -> Tensor<B, 3> {
+        // Images are [H, W, C], need them as [N, C, H, W].
+        let img1 = img1.permute([2, 0, 1]).unsqueeze();
+        let img2 = img2.permute([2, 0, 1]).unsqueeze();
