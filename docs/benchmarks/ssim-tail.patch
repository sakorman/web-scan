+    fn sample(
+        &mut self,
+        path: &Path,
+        sample: &DynamicImage,
+        device: &B::Device,
+    ) -> (burn::tensor::Tensor<B, 3>, bool) {
+        if let Some(tensor) = self.tensors.get(path) {
+            return (tensor.clone(), true);
+        }
+        let tensor = sample_to_tensor::<B>(sample, device);
+        let bytes = tensor.dims().iter().product::<usize>() * std::mem::size_of::<B::FloatElem>();
+        if bytes <= self.max_bytes.saturating_sub(self.bytes) {
+            self.tensors.insert(path.to_path_buf(), tensor.clone());
+            self.bytes += bytes;
+        }
+        (tensor, false)
+    }
 }
 
