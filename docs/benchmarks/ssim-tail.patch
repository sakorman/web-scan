+
+    fn check(label: &str, shape: [usize; 3], actual: &[f32], expected: &[f32]) {
+        assert_eq!(actual.len(), expected.len());
+        let errors: Vec<_> = actual
+            .iter()
+            .zip(expected)
+            .map(|(a, b)| (*a as f64 - *b as f64).abs())
+            .collect();
+        let (index, maximum) = errors
+            .iter()
+            .enumerate()
+            .max_by(|a, b| a.1.total_cmp(b.1))
+            .unwrap();
+        let count = errors.iter().filter(|v| **v > 1e-5).count();
+        println!(
+            "WS_TAIL {:?} {label} {} {index} {} {} {count}",
+            shape, maximum, actual[index], expected[index]
+        );
+        assert!(actual.iter().all(|v| v.is_finite()));
+    }
+
+    #[test]
+    fn permuted_copy_preserves_tail() {
+        let device = super::ssim_test_device();
+
+        for width in [624, 625, 626, 627, 628] {
+            let shape = [469, width, 3];
+            let count = shape.iter().product::<usize>();
+            let values: Vec<f32> = (0..count)
+                .map(|i| (i % 251) as f32 / 256.0 + 0.01)
+                .collect();
+            let expected: Vec<f32> = (0..3)
+                .flat_map(|c| values.iter().skip(c).step_by(3).copied())
+                .collect();
+            let actual = Tensor::<MainBackend, 1>::from_floats(values.as_slice(), &device)
+                .reshape(shape)
+                .permute([2, 0, 1])
+                .into_data()
+                .into_vec::<f32>()
+                .unwrap();
+            assert_eq!(actual.len(), expected.len());
+            let mismatches = actual.iter().zip(&expected).filter(|(a, b)| a != b).count();
+            println!("WS_TAIL_REGRESSION {width} {count} {mismatches}");
+            assert_eq!(
+                mismatches, 0,
+                "permuted tensor data was not fully written: width {width}"
+            );
+        }
+    }
+
+    #[test]
+    fn probe_tensor_tail() {
+        let device = super::ssim_test_device();
+
+        for shape in [[13, 17, 3], [469, 624, 3], [469, 626, 3], [469, 628, 3]] {
+            let n = shape.iter().product::<usize>();
+            let values: Vec<f32> = (0..n).map(|i| (i % 251) as f32 / 256.0 + 0.01).collect();
+            let squares: Vec<f32> = values.iter().map(|v| v * v).collect();
+            for repeat in 0..2 {
+                let load = || {
+                    Tensor::<MainBackend, 1>::from_floats(values.as_slice(), &device).reshape(shape)
+                };
+                let upload = load().into_data().into_vec::<f32>().unwrap();
+                check(&format!("upload_{repeat}"), shape, &upload, &values);
+                let x = load();
+                let product = (x.clone() * x).into_data().into_vec::<f32>().unwrap();
+                check(&format!("hwc_multiply_{repeat}"), shape, &product, &squares);
+                let x = load().permute([2, 0, 1]);
+                let permuted = x.clone().into_data().into_vec::<f32>().unwrap();
+                let expected_chw: Vec<f32> = (0..3)
+                    .flat_map(|c| values.iter().skip(c).step_by(3).copied())
+                    .collect();
+                check(
+                    &format!("chw_read_{repeat}"),
+                    shape,
+                    &permuted,
+                    &expected_chw,
+                );
+                let product = (x.clone() * x)
+                    .permute([1, 2, 0])
+                    .into_data()
+                    .into_vec::<f32>()
+                    .unwrap();
+                check(&format!("chw_multiply_{repeat}"), shape, &product, &squares);
+                let ssim = Ssim::<MainBackend>::new(11, 3, &device);
+                let blur = ssim.gaussian_blur(load().permute([2, 0, 1]).unsqueeze());
+                let first = blur.clone().into_data().into_vec::<f32>().unwrap();
+                let second = ssim
+                    .gaussian_blur(load().permute([2, 0, 1]).unsqueeze())
+                    .into_data()
+                    .into_vec::<f32>()
+                    .unwrap();
+                check(&format!("blur_repeat_{repeat}"), shape, &second, &first);
+            }
+        }
+    }
