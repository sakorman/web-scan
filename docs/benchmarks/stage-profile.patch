+#[cfg(test)]
+mod refinement_order_tests {
+    use super::refinement_order;
+    use std::collections::BTreeMap;
+
+    #[test]
+    fn parent_to_sample_assignment_ignores_container_order() {
+        let a = [10, 2, 100, 0];
+        let b = [100, 0, 2, 10];
+        let samples = [0.25_f32, -0.5, 1.0, 0.75];
+        let assign = |order| {
+            refinement_order(order, true)
+                .into_iter()
+                .zip(samples)
+                .collect::<BTreeMap<_, _>>()
+        };
+        assert_eq!(assign(a), assign(b));
+        assert_eq!(
+            assign(a).keys().copied().collect::<Vec<_>>(),
+            vec![0, 2, 10, 100]
+        );
+        assert_eq!(refinement_order(a, false), a);
+        assert!(refinement_order([], true).is_empty());
+        assert_eq!(refinement_order([7], true), vec![7]);
+    }
+}
