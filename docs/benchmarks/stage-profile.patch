+        let device = WgpuDevice::default();
+        let image = DynamicImage::ImageRgb8(RgbImage::from_pixel(2, 2, Rgb([16, 32, 64])));
+        let path = Path::new("image.jpg");
+        let mut cache = TensorCache::<MainBackend>::new(48);
